rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfiles: cualquiera logueado (anónimo) los lee; solo el dueño escribe el suyo
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Chats: el id es "uidA|uidB"; solo los dos participantes
    match /chats/{chatId}/messages/{msgId} {
      allow read, create: if request.auth != null && request.auth.uid in chatId.split('|');
    }
    // Catálogo compartido de películas (las agrega quien las busca en TMDB)
    match /movies/{movieId} {
      allow read, create: if request.auth != null;
    }
    // Salas de trivia: cualquiera logueado con el enlace puede leer/unirse/actualizar
    match /rooms/{roomId} {
      allow read, create, update: if request.auth != null;
    }
  }
}
